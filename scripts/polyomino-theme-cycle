#!/usr/bin/env bash
set -euo pipefail

# Directory where the primary theme switch script lives
SCRIPT_DIR="${HOME}/.local/bin"
THEME_SCRIPT="${SCRIPT_DIR}/polyomino-theme"

# State file storing the current theme (FLAVOR)
STATE_FILE="${HOME}/.config/polyomino/theme/state"

# Determine current theme
if [[ -f "${STATE_FILE}" ]]; then
  current=$(grep '^FLAVOR=' "${STATE_FILE}" | cut -d= -f2-)
else
  current=""
fi

# Ordered list of approved themes
themes=("matriz" "encruza" "caravela" "aruanda")

# Find current index
idx=-1
for i in "${!themes[@]}"; do
  if [[ "${themes[i]}" == "${current}" ]]; then
    idx=$i
    break
  fi
done

# Compute next theme (wrap around)
if [[ $idx -eq -1 ]]; then
  next="${themes[0]}"
else
  next_index=$(( (idx + 1) % ${#themes[@]} ))
  next="${themes[next_index]}"
fi

# Execute the main theme switch script with the next theme
exec "${THEME_SCRIPT}" "${next}"
