.dotfiles_backup/
*.swp
.DS_Store

# CLI/agent tooling artifacts that can appear in this directory — not part of
# the dotfiles project.
.agent/
.agents/
.claude/
.github/*
!.github/copilot-instructions.md
!.github/workflows/
_bmad/
.cumulus-sdd/*

# Generated by scripts/theme.sh — derived from themes/palettes/*.sh + saved
# state in ~/.config/dotfiles/theme/state; regenerated on every theme change
# and on every ./install.sh run. Not meant to be hand-edited or tracked.
config/sway/colors.conf
config/kitty/colors.conf
config/waybar/style.css
config/wofi/style.css

# Tracked SVG defaults are kept; personal raster wallpapers remain ignored.
themes/wallpapers/*
!themes/wallpapers/*.svg
!themes/wallpapers/ATTRIBUTION.md

# Rust build artifacts (the cumulus-theme port). Cargo.lock is tracked
# (binary crate best practice) — only the build output is ignored.
/target/
