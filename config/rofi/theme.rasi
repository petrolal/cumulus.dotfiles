/* Generated by cumulus.dotfiles theme engine — flavor=aws */
* {
    bg: #071521;
    fg: #E0E6ED;
    accent: #FF9900;
    mantle: #040D15;
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @fg;
}
window {
    background-color: @bg;
    text-color: @fg;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
    padding: 12px;
    width: 600px;
}
mainbox {
    children: [ inputbar, listview ];
}
inputbar {
    children: [ prompt, entry ];
    background-color: @mantle;
    border-radius: 6px;
    padding: 8px;
    margin: 0 0 12px 0;
}
prompt {
    background-color: @accent;
    text-color: @bg;
    padding: 4px 8px;
    border-radius: 4px;
}
entry {
    placeholder: "Search apps...";
    placeholder-color: #6c7086;
    padding: 4px 8px;
    text-color: @fg;
}
listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
}
element {
    padding: 8px;
    border-radius: 6px;
}
element selected {
    background-color: @accent;
    text-color: @bg;
}
element-text {
    text-color: inherit;
}
element-icon {
    size: 24px;
    margin: 0 8px 0 0;
}
