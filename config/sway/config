### ~/.config/sway/config
### Production Sway configuration — Ubuntu 24.04, enterprise/dev workstation.
### Style: plain, native Sway defaults + Catppuccin Mocha colors. No animations,
### no SwayFX, no experimental compositors. ML4W-inspired keybindings.
###
### Reload after edits with: SUPER+SHIFT+C  (or `swaymsg reload`)

### ────────────────────────────────────────────────────────────────
### Variables
### ────────────────────────────────────────────────────────────────
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $launcher wofi --show drun --allow-images --conf ~/.config/wofi/config --style ~/.config/wofi/style.css
set $lock ~/.config/sway/scripts/polyomino-rubik-lock

set $ws1 "1:web"
set $ws2 "2:code"
set $ws3 "3:term"
set $ws4 "4:containers"
set $ws5 "5:comms"
set $ws6 "6:notes"
set $ws7 "7:infra"
set $ws8 "8:misc"
set $ws9 "9:scratch"

### ────────────────────────────────────────────────────────────────
### Autostart (Wayland-first, corporate-compatible)
### ────────────────────────────────────────────────────────────────
# Wallpaper + client colors — generated by `polyomino-theme`, do not edit directly.
# Run `polyomino-theme set <flavor> [--wallpaper <path>|--flat]`; use
# `polyomino-theme list` for Catppuccin and AWS/Azure/GCP/OCI choices.
include colors.conf

# Notification daemon (SwayNC) — Wayland-native notification center with history & control panel.
exec_always pgrep -x swaync >/dev/null || swaync

# Status bar
exec_always pgrep -x waybar >/dev/null || waybar

# Floating calendar popup rule
for_window [app_id="polyomino-calendar"] floating enable, resize set 680 440, move position center

# Floating lockscreen preview window
for_window [app_id="polyomino-lock-preview"] floating enable, resize set 1024 720, move position center

# System tray helper for network/VPN status (OpenVPN3 is CLI-only; nm-applet shows NetworkManager
# connection state including VPN tunnels started via `nmcli` or the openvpn3 CLI-managed profiles).
exec nm-applet --indicator

# 1Password — starts minimized to tray, unlocks against the already-running gnome-keyring/PAM session.
exec 1password --silent

# Idle management (lock -> screen off -> suspend). Integrated with polyomino-rubik-lock.
exec swayidle -w timeout 300 '~/.local/bin/polyomino-rubik-lock' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'

# Fibonacci spiral autotiling — splits focused window along its longer axis automatically.
exec_always ~/.local/bin/polyomino-autotiling

# Set FastFetch logo 
exec_always --no-startup-id ~/.config/fastfetch/set_logo.sh

# Polkit authentication agent — required for GUI privilege prompts (Intune, NetworkManager, disk mounts).
# GNOME's polkit agent is reused since it is desktop-agnostic; no separate install needed.
exec /usr/libexec/polkit-gnome-authentication-agent-1

### ────────────────────────────────────────────────────────────────
### Environment variables (Wayland-first app behavior)
### ────────────────────────────────────────────────────────────────
# Force Wayland-native rendering where supported; apps without Wayland support automatically fall
# back to XWayland (already provided by the `sway` package dependency chain), so nothing breaks.
exec_always systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK
exec_always hash dbus-update-activation-environment 2>/dev/null && \
  dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

set $XDG_CURRENT_DESKTOP sway
set $XDG_SESSION_TYPE wayland
set $MOZ_ENABLE_WAYLAND 1
set $NIXOS_OZONE_WL 1

### ────────────────────────────────────────────────────────────────
### Output (monitor) configuration — auto-detect + sane fallback
### ────────────────────────────────────────────────────────────────
# Default display layout: built-in screen on left, HDMI monitor on right
output eDP-1 position 0 0
output HDMI-A-1 position 1920 0
output HDMI-* position 1920 0

# Discover exact output names any time with: swaymsg -t get_outputs

### ────────────────────────────────────────────────────────────────
### Input configuration
### ────────────────────────────────────────────────────────────────
seat * shortcuts_inhibitor disable

input type:keyboard {
    xkb_layout us
    xkb_variant intl
    repeat_delay 300
    repeat_rate 40
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

### ────────────────────────────────────────────────────────────────
### Appearance — Catppuccin (flavor selectable via `polyomino-theme`), no animations/effects
### ────────────────────────────────────────────────────────────────
font pango:JetBrainsMono Nerd Font 10

# class/border/bg/text/indicator/child_border colors are generated by
# `polyomino-theme` into colors.conf (included above, near the top of this file).

default_border pixel 2
default_floating_border pixel 2
gaps inner 10
gaps outer 0
smart_borders on

# SwayFX eye-candy (rounded corners, blur, shadows)
corner_radius 10
blur enable
blur_radius 5
blur_passes 2
shadows enable
shadow_blur_radius 20

### ────────────────────────────────────────────────────────────────
### Workspace names (mapped to numbers so SUPER+1..9 still works)
### ────────────────────────────────────────────────────────────────
workspace $ws1
workspace $ws2
workspace $ws3
workspace $ws4
workspace $ws5
workspace $ws6
workspace $ws7
workspace $ws8
workspace $ws9

### ────────────────────────────────────────────────────────────────
### Application -> workspace assignment
### ────────────────────────────────────────────────────────────────
# Matched by Wayland app_id where the app supports Wayland natively, and by X11 window class
# as a fallback for apps still running under XWayland (IntelliJ, some Electron builds).

# 1: web
assign [app_id="microsoft-edge"] $ws1
assign [class="Microsoft-edge"] $ws1
assign [app_id="firefox"] $ws1
assign [class="firefox"] $ws1
assign [app_id="google-chrome"] $ws1
assign [class="google-chrome"] $ws1

# 2: code
assign [class="jetbrains-idea"] $ws2
assign [class="jetbrains-idea-ce"] $ws2
assign [app_id="code"] $ws2
assign [class="Code"] $ws2

# 3: term
assign [app_id="kitty"] $ws3

# 4: containers
assign [app_id="docker-desktop"] $ws4
assign [class="Docker Desktop"] $ws4
assign [app_id="lens"] $ws4
assign [class="Lens"] $ws4

# 5: comms
assign [app_id="thunderbird"] $ws5
assign [class="Thunderbird"] $ws5
assign [app_id="aerc"] $ws5
assign [class="aerc"] $ws5

# 6: notes
assign [app_id="obsidian"] $ws6
assign [class="obsidian"] $ws6

# 7: infra — terminal windows explicitly titled for VPN/infra work land here;
# general infra CLI (openvpn3, kubectl, etc.) is run inside kitty terminals you move manually
# with SUPER+SHIFT+7, since CLI tools have no window of their own to match on.
assign [app_id="kitty" title="infra"] $ws7

# 8: misc
assign [app_id="telegramdesktop"] $ws8
assign [class="TelegramDesktop"] $ws8

### ────────────────────────────────────────────────────────────────
### Key bindings — stock Sway defaults (overrides previous ML4W custom set)
### ────────────────────────────────────────────────────────────────

# Basics & TUI Tools
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec $launcher
bindsym $mod+Shift+b exec google-chrome-stable
bindsym $mod+Shift+f exec $term -e yazi
bindsym $mod+Shift+m exec $term -e spotify_player
bindsym $mod+Shift+u exec $term -e bluetui
bindsym $mod+Shift+v exec $term -e ncpamixer
bindsym $mod+Shift+a exec $term -e aerc
bindsym $mod+Shift+n exec swaync-client -t -sw
floating_modifier $mod normal
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Moving around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Draw interactive floating window with slurp
bindsym $mod+Shift+w exec ~/.local/bin/sway-draw-window # Draw window geometry (resize current or spawn)
bindsym $mod+Shift+Return exec ~/.local/bin/sway-draw-window --spawn # Draw and spawn new floating terminal
bindsym $mod+Shift+g exec ~/.local/bin/sway-draw-window # Draw window geometry (alias)

# Scratchpad
bindsym $mod+Shift+minus move scratchpad, $send-notify 'Scratchpad'
bindsym $mod+minus scratchpad show

# Resizing
bindsym $mod+r mode "resize"

# which-key style cheatsheet — shows all bindings from this config in wofi
bindsym $mod+question exec ~/.local/bin/polyomino-whichkey
bindsym $mod+slash exec ~/.local/bin/polyomino-whichkey
bindsym $mod+Shift+slash exec ~/.local/bin/polyomino-whichkey
bindsym $mod+Shift+question exec ~/.local/bin/polyomino-whichkey


# Display configuration — wdisplays GUI for multi-monitor setup
bindsym $mod+Shift+d exec wdisplays

# Theme picker — wofi GUI to pick a cloud flavor + background mode
# (flat color / wallpaper / rotate), front-end for polyomino-theme.
bindsym $mod+Shift+t exec ~/.local/bin/polyomino-theme-picker
bindsym $mod+F5 exec ~/.local/bin/polyomino-theme-cycle
bindsym $mod+F1 exec polyomino-theme matriz
bindsym $mod+F2 exec polyomino-theme encruza
bindsym $mod+F3 exec polyomino-theme caravela
bindsym $mod+F4 exec polyomino-theme aruanda

# Lock screen, suspend, and shutdown
# Note: lock is bound to $mod+Escape (not $mod+Shift+l — that collides with $mod+Shift+$right
# (vim-style "l" = right, see `set $right l` above), which silently wins
# and made sway show a "there are errors in your config" banner).
bindsym $mod+Escape exec ~/.local/bin/polyomino-rubik-lock
bindsym $mod+Shift+x exec $term -e ~/.config/sway/scripts/matrix.sh # Terminal matrix screensaver
bindsym $mod+Shift+Escape exec systemctl suspend # Suspend system

bindsym $mod+Control+Escape exec systemctl poweroff # Shutdown system
bindsym $mod+Control+Shift+Escape exec systemctl reboot # Reboot system

# Screenshots — saved to ~/Pictures/Screenshots and copied to clipboard
bindsym Print exec ~/.local/bin/polyomino screenshot full
bindsym --release Print exec ~/.local/bin/polyomino screenshot full
bindcode 107 exec ~/.local/bin/polyomino screenshot full
bindsym $mod+Print exec ~/.local/bin/polyomino screenshot region
bindsym $mod+Shift+Print exec ~/.local/bin/polyomino screenshot window

# Audio, Media & Hardware Keys (WirePlumber / PipeWire / playerctl)
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute     exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioPlay        exec playerctl play-pause
bindsym --locked XF86AudioNext        exec playerctl next
bindsym --locked XF86AudioPrev        exec playerctl previous
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-


### ────────────────────────────────────────────────────────────────
### Modes
### ────────────────────────────────────────────────────────────────
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

### ────────────────────────────────────────────────────────────────
### Bar (disabled — Waybar replaces the built-in swaybar entirely)
### ────────────────────────────────────────────────────────────────
bar {
    mode invisible
}

### ────────────────────────────────────────────────────────────────
### Corporate/Wayland compatibility notes (read before editing further)
### ────────────────────────────────────────────────────────────────
# - Microsoft Edge: launched via `microsoft-edge-stable`, which auto-detects the Wayland session
#   and enables `--ozone-platform=wayland` internally on 24.04's packaged build. No flag needed.
# - Intune Company Portal / Microsoft Identity Broker / Entra SSO: pure D-Bus/systemd services,
#   unaffected by window manager. No Sway-specific configuration required.
# - OpenVPN3: CLI-driven (`openvpn3 session-start --config ...`); NetworkManager/nm-applet in the
#   tray reflects VPN state if the profile is imported into NetworkManager instead of used standalone.
# - Screen sharing (Teams/Zoom in Chromium/Firefox): requires xdg-desktop-portal-wlr + PipeWire,
#   both installed/enabled by install.sh. Browsers will prompt for a portal screen picker.
