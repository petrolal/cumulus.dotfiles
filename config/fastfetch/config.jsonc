// Fastfetch configuration for Polyomino dotfiles suite
// Location: config/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/assets/polyomino_tetris.txt",
        "color": {
            "1": "yellow"
        },
        "padding": { "right": 2 }
    },
    "display": {
        "separator": " → "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "custom",
            "key": "OS/Theme",
            "format": "Polyomino (Sway wm)"
        },
        {
            "type": "custom",
            "key": "Path",
            "format": "BSB -> LIS"
        },
        {
            "type": "command",
            "key": "Theme",
            "text": "grep '^FLAVOR=' ~/.config/polyomino/theme/state 2>/dev/null | cut -d= -f2- || echo 'matriz'"
        },
        "host",
        "kernel",
        "uptime",
        "packages",
        "break",
        {
            "type": "wm",
            "key": "WM"
        },
        "terminal",
        "shell",
        "break",
        {
            "type": "cpu",
            "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}"
        },
        "gpu",
        "memory",
        {
            "type": "disk",
            "key": "Disk"
        },
        {
            "type": "battery",
            "key": "Battery"
        },
        "break",
        "colors"
    ]
}
