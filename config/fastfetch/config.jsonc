// Fastfetch configuration for Polyomino dotfiles suite
// Location: config/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "cat",
        "source": "assets/polyomino_cube.txt",
        "padding": { "right": 2 }
    },
    "display": {
        "separator": " → "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        {
            "type": "cpu",
            "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}"
        },
        "gpu",
        "memory",
        "break",
        "colors"
    ]
}
