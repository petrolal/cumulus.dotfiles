### ~/.config/wofi/config
### Minimal, fast launcher config — no theming tricks, DRUN mode only.

width=600
height=400
location=center
show=drun
prompt=Search apps...
filter_rate=100
allow_markup=true
no_actions=true
halign=fill
orientation=vertical
content_halign=fill
insensitive=true
allow_images=true
image_size=32
gtk_dark=true
