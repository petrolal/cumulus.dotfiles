/* ~/.config/wofi/style.css.tmpl — template for scripts/theme.sh
 * Rendered directly into style.css (not @import, since wofi's GTK CSS
 * provider resolves @import relative to its process CWD, not this file's
 * location — an absolute path would work but would hardcode $HOME into a
 * git-tracked file, so full rendering is more portable).
 * Placeholders (@@NAME@@) are substituted with hex colors by theme.sh.
 */

window {
    background-color: #191C24;
    color: @@TEXT@@;
    border: 2px solid #2B303C;
    border-radius: 12px;
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
}

#input {
    background-color: #0F1117;
    color: @@TEXT@@;
    border: 1px solid #2B303C;
    border-radius: 8px;
    padding: 8px 12px;
    margin: 12px;
}

#inner-box {
    background-color: transparent;
    margin: 4px 8px;
}

#outer-box {
    padding: 4px;
}

#scroll {
    margin: 4px;
}

#entry {
    padding: 10px;
    margin: 4px;
    border-radius: 12px;
    background-color: #0F1117;
}

#entry:selected {
    background-color: #EBB434;
    color: #0F1117;
    border-radius: 12px;
}

#text {
    color: @@TEXT@@;
}

#text:selected {
    color: #0F1117;
}

