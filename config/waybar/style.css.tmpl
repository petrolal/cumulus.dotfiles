/* ~/.config/waybar/style.css.tmpl — template for scripts/theme.sh; placeholders (@@NAME@@) substituted with hex colors */

* {
    font-family: "JetBrainsMono Nerd Font", sans-serif;
    font-size: 13px;
    min-height: 0;
    border: none;
    border-radius: 0;
    transition: none;
}

window#waybar {
    background-color: @@BASE@@;
    color: @@TEXT@@;
}

#workspaces button {
    padding: 0 8px;
    background-color: transparent;
    color: @@SUBTEXT0@@;
}

#workspaces button.focused {
    background-color: @@SURFACE0@@;
    color: @@BLUE@@;
}

#workspaces button.urgent {
    background-color: @@RED@@;
    color: @@BASE@@;
}

#clock,
#tray,
#network,
#bluetooth,
#pulseaudio,
#backlight,
#battery,
#custom-notification,
#mode {
    padding: 0 10px;
    margin: 0 2px;
    color: @@TEXT@@;
}

#battery.warning {
    color: @@YELLOW@@;
}

#battery.critical {
    color: @@RED@@;
}

#network.disconnected {
    color: @@RED@@;
}

#custom-notification.notification {
    color: @@BLUE@@;
}

#custom-notification.dnd-notification,
#custom-notification.dnd-none,
#custom-notification.dnd-inhibited-notification,
#custom-notification.dnd-inhibited-none {
    opacity: 0.6;
}

#tray > .passive {
    opacity: 0.6;
}

#tray > .needs-attention {
    background-color: @@RED@@;
}

