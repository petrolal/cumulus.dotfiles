// ~/.config/waybar/config.jsonc
// Production Waybar layout — ML4W floating pill style.
{
	"include": "~/.config/waybar/modules.jsonc",
	"layer": "top",
	"position": "top",
	"height": 32,
	"spacing": 6,
	"margin-top": 6,
	"margin-left": 8,
	"margin-right": 8,
	"modules-left": [
		"sway/workspaces",
		"custom/spotify"
	],
	"modules-center": [
		"sway/mode",
		"sway/window"
	],
	"modules-right": [
		"pulseaudio",
		"bluetooth",
		"network",
		"cpu",
		"memory",
		"battery",
		"clock",
		"tray"
	]

}
